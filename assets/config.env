# jnctunnel - konfigurasi utama
# Dibaca installer, menu, dan timer kedaluwarsa. Format: KEY=nilai

DOMAIN=""
EMAIL=""

# Port SSH langsung (dropbear)
SSH_MAIN_PORT=109
SSH_ALT_PORT=143

# Port lokal, tidak dibuka ke publik
SSHWS_PORT=2082
NGINX_HTTP_PORT=8083
NGINX_GRPC_PORT=8081

# Port Xray (semua listen 127.0.0.1)
XRAY_VMESS_WS=10001
XRAY_VLESS_WS=10002
XRAY_TROJAN_WS=10003
XRAY_VMESS_UP=10004
XRAY_VLESS_UP=10005
XRAY_TROJAN_UP=10006
XRAY_VMESS_GRPC=11001
XRAY_VLESS_GRPC=11002
XRAY_TROJAN_GRPC=11003
XRAY_VLESS_XHTTP=12002

# Masa aktif bawaan (hari) saat membuat akun dari menu
DEFAULT_DAYS=30
